DATABASE_URL=postgres://postgres:local-development-only@127.0.0.1:55432/server_ops
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=8080
# Public demos are read-only; all records and exports will be public.
DEMO_MODE=true
OWNER_USERNAME=owner
# Required when DEMO_MODE=false. Generate from stdin with npm run password.
OWNER_PASSWORD_HASH=

# Optional: exact sanitizing-proxy IPs; self is for verified rootless port forwarding.
# Keep backend host ports loopback-only. Empty means forwarded headers are ignored.
TRUST_PROXY_IPS=

# Read-only demos only: UTC date when the sample was prepared. Blank keeps stored dates.
# Dates are projected relative to today in API responses; stored records are never rewritten.
DEMO_DATE_ANCHOR=
